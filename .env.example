# URL del endpoint que devuelve el archivo de configuración (texto plano). Obligatorio.
ENDPOINT_URL=https://example.com/nginx/default.conf

# Nombre del archivo a escribir dentro de OUTPUT_DIR. Sin barras ni "..".
OUTPUT_FILENAME=default.conf

# Directorio de salida, relativo a la raíz del proyecto.
OUTPUT_DIR=sites-enabled

# Puerto del servidor express.
PORT=3000

# Token bearer requerido por POST /sync. Vacío = ruta deshabilitada (503).
SYNC_TOKEN=

# Valor del header Authorization al llamar a ENDPOINT_URL. Opcional.
# Ej: "Bearer abc123" o "token abc123".
ENDPOINT_AUTH=

# Timeout de la descarga en ms.
REQUEST_TIMEOUT_MS=15000

# Sincronizar al arrancar el servidor (true/false).
SYNC_ON_BOOT=true
