# URL del endpoint que devuelve el archivo de configuración (texto plano). Obligatorio.
ENDPOINT_URL=https://example.com/nginx/default.conf

# Nombre del archivo a escribir dentro de OUTPUT_DIR. Sin barras ni "..".
OUTPUT_FILENAME=default.conf

# Directorio de salida, relativo a la raíz del proyecto.
OUTPUT_DIR=sites-enabled

# Puerto del servidor express.
PORT=3000

# Token bearer requerido por POST /sync. Vacío = ruta deshabilitada (503).
SYNC_TOKEN=

# Valor del header Authorization al llamar a ENDPOINT_URL. Opcional.
# Ej: "Bearer abc123" o "token abc123".
ENDPOINT_AUTH=

# Timeout de la descarga en ms.
REQUEST_TIMEOUT_MS=15000

# Sincronizar al arrancar el servidor (true/false).
SYNC_ON_BOOT=true

# --- Reload de nginx -------------------------------------------------------
# Recargar nginx cuando la configuración descargada cambia. Requiere sudoers
# (ver README). Desactivado por defecto: ejecutar comandos como root es opt-in.
NGINX_RELOAD=false

# Validación previa al reload. Vacío = omitir la validación (no recomendado).
NGINX_TEST_CMD=sudo nginx -t

# Comando de recarga.
NGINX_RELOAD_CMD=sudo systemctl reload nginx

# --- Reintentos ------------------------------------------------------------
# Espera entre reintentos cuando la descarga falla.
RETRY_DELAY_MS=30000

# Intentos del servidor. 0 = reintentar indefinidamente.
RETRY_MAX_ATTEMPTS=0

# Intentos del CLI one-shot (bun run sync / app cron de PM2).
CLI_RETRY_MAX_ATTEMPTS=3
